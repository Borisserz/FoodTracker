    "Daily reminders help you log lunch (13:00), dinner (19:00), and afternoon hydration (15:00) consistently.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tägliche Erinnerungen helfen dir, Mittagessen (13:00), Abendessen (19:00) und Wasser (15:00) regelmäßig zu erfassen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Daily reminders help you log lunch (13:00), dinner (19:00), and afternoon hydration (15:00) consistently."
          }
