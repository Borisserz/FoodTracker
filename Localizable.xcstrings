          "stringUnit": {
            "state": "translated",
            "value": "¿Puedo cenar pizza hoy? ¿Cómo tomar más proteína? Pregunta lo que quieras."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
