        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los recordatorios diarios te ayudan a registrar el almuerzo (13:00), la cena (19:00) y la hidratación (15:00) con constancia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les rappels quotidiens vous aident à enregistrer le déjeuner (13:00), le dîner (19:00) et l'hydratation (15:00) régulièrement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I promemoria giornalieri ti aiutano a registrare con costanza pranzo (13:00), cena (19:00) e idratazione (15:00)."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os lembretes diários ajudam-te a registar o almoço (13:00), o jantar (19:00) e a hidratação da tarde (15:00) com regularidade."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ежедневные напоминания помогут регулярно записывать обед (13:00), ужин (19:00) и дневную норму воды (15:00)."
