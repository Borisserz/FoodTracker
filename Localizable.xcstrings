    "Rest. Transfer the steak to a cutting board. Do not slice yet! Let it rest for 5 minutes.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отдых. Переложи стейк на доску. Не разрезай! Дай ему отдохнуть 5 минут."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ruhen lassen. Steak aufs Brett legen und noch nicht schneiden! 5 Minuten ruhen lassen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reposo. Pasa el filete a la tabla y déjalo reposar 5 minutos sin cortar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Repos. Posez le steak sur une planche et laissez reposer 5 minutes sans couper."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riposo. Sposta la bistecca sul tagliere e lasciala riposare 5 minuti senza tagliarla."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Descanso. Passe o bife para a tábua e deixe repousar 5 minutos sem cortar."
          }
        }
      }
    },
