    "Your FoodTracker account and local data were deleted, but automatic Sign in with Apple revocation failed (%@). Please revoke access manually in iOS Settings → Apple Account → Sign in with Apple.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your FoodTracker account and local data were deleted, but automatic Sign in with Apple revocation failed (%@). Please revoke access manually in iOS Settings → Apple Account → Sign in with Apple."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Аккаунт FoodTracker и локальные данные удалены, но не удалось автоматически отозвать доступ Sign in with Apple (%@). Отзовите доступ вручную в Настройках iOS → Аккаунт Apple → Вход с Apple."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein FoodTracker-Konto und lokale Daten wurden gelöscht, aber der automatische Widerruf von Mit Apple anmelden ist fehlgeschlagen (%@). Bitte widerrufe den Zugriff manuell unter iOS-Einstellungen → Apple-Account → Mit Apple anmelden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu cuenta de FoodTracker y los datos locales se eliminaron, pero falló la revocación automática de Iniciar sesión con Apple (%@). Revoca el acceso manualmente en Ajustes de iOS → Cuenta de Apple → Iniciar sesión con Apple."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre compte FoodTracker et vos données locales ont été supprimés, mais la révocation automatique de Connexion avec Apple a échoué (%@). Révoquez l’accès manuellement dans Réglages iOS → Compte Apple → Connexion avec Apple."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo account FoodTracker e i dati locali sono stati eliminati, ma la revoca automatica di Accedi con Apple non è riuscita (%@). Revoca l’accesso manualmente in Impostazioni iOS → Account Apple → Accedi con Apple."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A sua conta FoodTracker e os dados locais foram eliminados, mas a revogação automática de Iniciar sessão com a Apple falhou (%@). Revogue o acesso manualmente em Definições do iOS → Conta Apple → Iniciar sessão com a Apple."
          }
        }
      }
    },
