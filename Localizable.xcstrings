    "The pan isn't hot enough yet. Wait 30 seconds.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сковорода ещё не раскалена. Подожди 30 секунд."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Pfanne ist noch nicht heiß genug. Warte 30 Sekunden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La sartén aún no está bastante caliente. Espera 30 s."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La poêle n'est pas assez chaude. Attendez 30 s."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La padella non è ancora abbastanza calda. Attendi 30 s."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A frigideira ainda não está quente. Aguarde 30 s."
          }
        }
      }
    },
    "This is optimized based on your profile goals. Feel free to adjust it manually.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Рассчитано под цели вашего профиля. При желании можно скорректировать вручную."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Basierend auf deinen Profilzielen optimiert. Du kannst es manuell anpassen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Optimizado según tu perfil. Puedes ajustarlo manualmente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Optimisé selon votre profil. Modifiable à tout moment."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ottimizzato sul tuo profilo. Puoi regolarlo manualmente."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Otimizado com base no seu perfil. Pode ajustar manualmente."
          }
        }
      }
    },
    "This permanently deletes your account and clears all meals, recipes, weight logs, and settings from this device.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это навсегда удалит ваш аккаунт и очистит все приёмы пищи, рецепты, записи веса и настройки на этом устройстве."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Löscht dein Konto dauerhaft sowie alle Mahlzeiten, Rezepte, Gewichtseinträge und Einstellungen auf diesem Gerät."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina tu cuenta y borra comidas, recetas, pesos y ajustes de este dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprime définitivement votre compte et toutes vos données sur cet appareil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina definitivamente il tuo account e tutti i dati locali da questo dispositivo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina permanentemente a conta e apaga todos os dados deste dispositivo."
          }
        }
      }
    },
    "This permanently deletes your guest account and clears all meals, recipes, weight logs, and settings from this device.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This permanently deletes your guest account and clears all meals, recipes, weight logs, and settings from this device."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это навсегда удалит ваш гостевой аккаунт и очистит все приёмы пищи, рецепты, замеры веса и настройки с этого устройства."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dadurch wird Ihr Gastkonto dauerhaft gelöscht und alle Mahlzeiten, Rezepte, Gewichtsprotokolle und Einstellungen werden von diesem Gerät entfernt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto elimina permanentemente tu cuenta de invitado y borra todas las comidas, recetas, registros de peso y ajustes de este dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela supprime définitivement votre compte invité et efface tous les repas, recettes, suivis de poids et réglages de cet appareil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo elimina definitivamente il tuo account ospite e cancella tutti i pasti, le ricette, i pesi e le impostazioni da questo dispositivo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Isto elimina permanentemente a sua conta de convidado e apaga todas as refeições, receitas, registos de peso e definições deste dispositivo."
          }
        }
      }
    },
    "This permanently deletes your shared ecosystem account (including WorkoutTracker sign-in) and clears all FoodTracker meals, recipes, weight logs, and settings from this device.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This permanently deletes your shared ecosystem account (including WorkoutTracker sign-in) and clears all FoodTracker meals, recipes, weight logs, and settings from this device."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это навсегда удалит ваш общий аккаунт экосистемы (включая вход в WorkoutTracker) и очистит все приёмы пищи, рецепты, замеры веса и настройки FoodTracker с этого устройства."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dadurch wird Ihr gemeinsames Ökosystem-Konto (einschließlich der WorkoutTracker-Anmeldung) dauerhaft gelöscht und alle FoodTracker-Mahlzeiten, Rezepte, Gewichtsprotokolle und Einstellungen werden von diesem Gerät entfernt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto elimina permanentemente tu cuenta compartida del ecosistema (incluido el acceso a WorkoutTracker) y borra todas las comidas, recetas, registros de peso y ajustes de FoodTracker de este dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela supprime définitivement votre compte partagé de l’écosystème (y compris la connexion à WorkoutTracker) et efface tous les repas, recettes, suivis de poids et réglages FoodTracker de cet appareil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo elimina definitivamente il tuo account condiviso dell'ecosistema (incluso l'accesso a WorkoutTracker) e cancella tutti i pasti, le ricette, i pesi e le impostazioni di FoodTracker da questo dispositivo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Isto elimina permanentemente a sua conta partilhada do ecossistema (incluindo o início de sessão no WorkoutTracker) e apaga todas as refeições, receitas, registos de peso e definições do FoodTracker deste dispositivo."
          }
        }
      }
    },
