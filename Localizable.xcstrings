    "Finish eating at least 3 hours before sleep. This lowers insulin levels and improves deep sleep recovery phases.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Finish eating at least 3 hours before sleep. This lowers insulin levels and improves deep sleep recovery phases."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beende das Essen mindestens 3 Stunden vor dem Schlafen. Das senkt Insulin und verbessert die Tiefschlaf-Regeneration."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Termina de comer al menos 3 horas antes de dormir. Esto reduce la insulina y mejora la fase de sueño profundo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminez votre dernier repas au moins 3 heures avant le coucher pour abaisser l'insuline et améliorer le sommeil profond."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Termina di mangiare almeno 3 ore prima di dormire: abbassa l'insulina e migliora il recupero del sonno profondo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Termina as refeições pelo menos 3 horas antes de dormir para reduzir a insulina e melhorar o sono profundo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Завершайте приём пищи минимум за 3 часа до сна — это снижает инсулин и улучшает глубокие фазы восстановления."
          }
        }
      }
    },
