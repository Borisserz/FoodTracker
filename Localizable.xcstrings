    "If every day was exactly like today.": {
      "comment": "A description under the projected weight change, explaining that the weight change is projected based on the user's current calorie deficit or surplus.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если каждый день будет таким же, как сегодня."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn jeder Tag genau wie heute wäre."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si cada día fuera exactamente como hoy."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si chaque journée était comme aujourd'hui."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se ogni giorno fosse esattamente come oggi."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Se todos os dias fossem como hoje."
          }
        }
      }
    },
    "If the app is closed, your plan generation will be interrupted. Keep the app open for best results.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If the app is closed, your plan generation will be interrupted. Keep the app open for best results."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если закрыть приложение, генерация плана прервётся. Не сворачивайте приложение до завершения."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn die App geschlossen wird, wird die Planerstellung unterbrochen. Bitte geöffnet lassen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si cierras la app se interrumpirá la creación del plan. Mantenla abierta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si vous fermez l'app, la génération sera interrompue. Gardez-la ouverte."
