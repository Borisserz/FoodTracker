            "value": "Noticing how '%@' connects with meals and hydration helps build sustainable habits over time."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zu beobachten, wie „%@“ mit Mahlzeiten und Hydration zusammenhängt, hilft langfristig bei stabilen Gewohnheiten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Observar cómo «%@» se conecta con tus comidas e hidratación ayuda a crear hábitos sostenibles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Observer comment « %@ » est lié aux repas et à l'hydratation aide à bâtir des habitudes durables."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Notare come «%@» si collega a pasti e idratazione aiuta a costruire abitudini durature nel tempo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
