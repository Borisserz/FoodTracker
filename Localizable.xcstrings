          "stringUnit": {
            "state": "translated",
            "value": "Подавай стейк на подогретой тарелке или деревянной доске. Нарежь поперёк волокон ломтиками по 1,5 см. Посыпь хлопьями морской соли для хруста и эффекта."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf vorgewärmtem Teller oder Holzbrett anrichten, quer zur Faser in 1,5 cm Streifen schneiden und mit Meersalzflocken bestreuen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sirve en plato caliente o tabla, corta a contrafibra en tiras de 1,5 cm y termina con escamas de sal marina."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Servez sur une assiette chaude ou une planche, tranchez à contre-fil en lanières de 1,5 cm avec de la fleur de sel."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Servi su piatto caldo o tagliere, affetta controfibra a strisce di 1,5 cm e completa con fiocchi di sale marino."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Sirva num prato aquecido ou tábua, corte contra a fibra em tiras de 1,5 cm e finalize com flor de sal."
          }
        }
      }
    },
    "Serve warm and garnish cleanly for best presentation.": {
