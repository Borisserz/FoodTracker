    "The Warrior Diet. 1-2 meals in a tight window.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Диета воина: 1–2 приёма пищи в узком окне."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Warrior Diet. 1–2 Mahlzeiten in einem kleinen Fenster."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieta del Guerrero: 1-2 comidas en ventana corta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Régime du guerrier : 1-2 repas dans une fenêtre courte."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieta del Guerriero: 1-2 pasti in finestra ristretta."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieta do Guerreiro: 1-2 refeições em janela curta."
          }
        }
      }
    },
    "The crust set properly. Move on to the next step.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Корочка схватилась правильно. Переходи к следующему шагу."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Kruste passt perfekt. Weiter zum nächsten Schritt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La costra está lista. Pasa al siguiente paso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La croûte est parfaite. Passez à l'étape suivante."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La crosta è perfetta. Passa al passaggio successivo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A crosta está no ponto. Avance para o próximo passo."
          }
        }
      }
    },
    "The golden standard of fasting. Perfect for fat loss.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Золотой стандарт голодания. Отлично для жиросжигания."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Goldstandard beim Fasten. Ideal zum Abnehmen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El estándar de oro del ayuno. Ideal para perder grasa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La référence du jeûne. Idéal pour perdre du gras."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo standard d'oro del digiuno. Ideale per dimagrire."
          }
        },
