    "Forces your body to burn fat for fuel instead of carbohydrates. Effective for rapid fat loss but requires strict adherence.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Переводит организм на сжигание жира вместо углеводов. Эффективно, но требует строгого соблюдения."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zwingt den Körper zur Fettverbrennung statt Kohlenhydrate. Effektiv, erfordert aber Konsequenz."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hace que el cuerpo queme grasa en lugar de carbohidratos. Eficaz, requiere constancia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Force le corps à brûler les graisses plutôt que les glucides. Efficace mais strict."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Spinge il corpo a bruciare grassi invece di carboidrati. Efficace ma rigorosa."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Faz o corpo queimar gordura em vez de hidratos. Eficaz, mas exige rigor."
          }
        }
      }
    },
