    "Review how your photos are processed before using AI visual analysis.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Review how your photos are processed before using AI visual analysis."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ознакомьтесь с тем, как обрабатываются ваши фото, перед использованием ИИ-анализа."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüfen Sie vor der Nutzung der KI-Bildanalyse, wie Ihre Fotos verarbeitet werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Revisa cómo se procesan tus fotos antes de usar el análisis visual con IA."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
