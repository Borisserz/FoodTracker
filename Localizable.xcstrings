    "High-heat sear. Heat a cast-iron skillet until lightly smoking. Add a drop of oil, drop the steak in, and sear for 2 minutes without moving it.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Шоковая жарка. Раскали чугунную сковороду до лёгкого дымка. Капни масло, выложи стейк и жарь ровно 2 минуты, не двигая его."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Scharfes Anbraten. Gusseisenpfanne stark erhitzen, etwas Öl dazugeben und das Steak 2 Minuten ohne Bewegen anbraten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sellado a fuego alto. Calienta una sartén de hierro, añade aceite y sella el filete 2 minutos sin moverlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisie à feu vif. Chauffe une poêle en fonte, ajoute une goutte d'huile et saisis le steak 2 minutes sans bouger."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rosolatura ad alta temperatura. Scalda una padella in ghisa, aggiungi olio e scotta la bistecca 2 minuti senza muoverla."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Selar em lume forte. Aqueça uma frigideira de ferro, junte óleo e sele o bife 2 minutos sem mexer."
          }
        }
      }
    },
