    "Low-stress days support great digestion and recovery. Keep sipping water and enjoy unhurried, nourishing meals.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Спокойные дни улучшают пищеварение и восстановление. Пейте воду и ешьте без спешки."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entspannte Tage fördern Verdauung und Regeneration. Trinke weiter Wasser und iss in Ruhe."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los días tranquilos favorecen la digestión y recuperación. Bebe agua y come sin prisas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les journées calmes favorisent la digestion et la récupération. Hydratez-vous et mangez sans vous presser."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le giornate serene aiutano digestione e recupero. Bevi acqua e gusta pasti nutrienti senza fretta."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Dias calmos favorecem a digestão e recuperação. Beba água e faça refeições tranquilas."
