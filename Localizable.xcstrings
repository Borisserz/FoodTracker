    "DANGER: Do not break with heavy carbs. Start with bone broth, wait an hour, eat steamed veggies and fish.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "ВАЖНО: Не выходите с быстрых углеводов. Начните с костного бульона, подождите час, затем овощи на пару и рыба."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "WICHTIG: Nicht mit schweren Carbs brechen. Mit Knochenbrühe starten, 1 Stunde warten, dann gedämpftes Gemüse & Fisch."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "IMPORTANTE: No rompas con carbohidratos pesados. Empieza con caldo, espera una hora y come verduras al vapor con pescado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "IMPORTANT : Ne rompez pas avec des glucides lourds. Commencez par du bouillon, attendez 1 h, puis légumes vapeur et poisson."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "IMPORTANTE: Non interrompere con carboidrati pesanti. Inizia con brodo, attendi 1 ora, poi verdure al vapore e pesce."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "IMPORTANTE: Não quebre com hidratos pesados. Comece com caldo, aguarde 1 h e coma legumes ao vapor com peixe."
          }
        }
      }
    },
