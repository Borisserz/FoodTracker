    "Photos are processed transiently with provider data retention disabled, and you can revoke this consent anytime in Settings.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Photos are processed transiently with provider data retention disabled, and you can revoke this consent anytime in Settings."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Фото обрабатываются транзитно с запретом хранения у провайдера; отозвать согласие можно в любой момент в Настройках."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotos werden nur temporär ohne Speicherung beim Anbieter verarbeitet; Sie können die Einwilligung jederzeit in den Einstellungen widerrufen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las fotos se procesan de forma temporal con la retención de datos desactivada, y puedes revocar este consentimiento en cualquier momento en Ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les photos sont traitées de manière transitoire sans conservation par le fournisseur, et vous pouvez retirer ce consentement à tout moment dans Réglages."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le foto vengono elaborate in modo transitorio con la conservazione dei dati disattivata e puoi revocare il consenso in qualsiasi momento nelle Impostazioni."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As fotos são processadas de forma transitória com a retenção de dados desativada e pode revogar este consentimento a qualquer momento nas Definições."
          }
        }
      }
    },
    "Photos are sent over encrypted HTTPS via FoodTracker's proxy to OpenRouter and third-party AI vision models to estimate nutrition and provide feedback.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Photos are sent over encrypted HTTPS via FoodTracker's proxy to OpenRouter and third-party AI vision models to estimate nutrition and provide feedback."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Фото отправляются по зашифрованному HTTPS через прокси FoodTracker в OpenRouter и сторонним визуальным ИИ-моделям для оценки КБЖУ и подсказок."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotos werden verschlüsselt per HTTPS über den FoodTracker-Proxy an OpenRouter und KI-Vision-Modelle von Drittanbietern zur Nährwertschätzung und Rückmeldung gesendet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las fotos se envían mediante HTTPS cifrado a través del proxy de FoodTracker a OpenRouter y modelos de visión de IA de terceros para estimar nutrientes y ofrecer recomendaciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les photos sont envoyées via HTTPS chiffré via le proxy de FoodTracker vers OpenRouter et des modèles de vision IA tiers pour estimer les valeurs nutritionnelles et donner des conseils."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le foto vengono inviate tramite HTTPS crittografato attraverso il proxy di FoodTracker a OpenRouter e a modelli di visione IA di terze parti per stimare i nutrienti e fornire consigli."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As fotos são enviadas por HTTPS encriptado através do proxy do FoodTracker para o OpenRouter e modelos de visão IA de terceiros para estimar nutrientes e dar recomendações."
          }
        }
      }
    },
    "Photos stay private on your device until you tap Analyze to send downsampled copies for AI visual comparison.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Photos stay private on your device until you tap Analyze to send downsampled copies for AI visual comparison."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotos bleiben privat auf deinem Gerät, bis du auf „Analysieren“ tippst, um verkleinerte Kopien für den KI-Vergleich zu senden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las fotos permanecen privadas en tu dispositivo hasta que tocas Analizar para enviar copias reducidas para la comparación visual por IA."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les photos restent privées sur votre appareil jusqu'à ce que vous touchiez Analyser pour envoyer des copies réduites à l'IA."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le foto restano private sul dispositivo finché non tocchi Analizza per inviare copie ridotte per il confronto visivo IA."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As fotos permanecem privadas no dispositivo até tocares em Analisar para enviar cópias reduzidas para comparação visual por IA."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Фотографии остаются на устройстве, пока вы не нажмёте «Анализ», чтобы отправить уменьшенные копии ИИ для визуального сравнения."
          }
        }
      }
    },
