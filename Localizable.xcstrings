    "I Understand, Start Fast": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Понятно, начать голодание"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verstanden, Fasten starten"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Entendido, iniciar ayuno"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Compris, démarrer le jeûne"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ho capito, inizia digiuno"
          }
        },
        "pt-PT": {
