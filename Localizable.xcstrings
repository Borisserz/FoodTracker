    "Skip black pepper so it doesn't overpower the delicate salmon flavor!": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не используй чёрный перец — он перебьёт нежный вкус лосося!"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lass schwarzen Pfeffer weg, damit der feine Lachsgeschmack erhalten bleibt!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¡Evita la pimienta negra para no tapar el sabor delicado del salmón!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Évitez le poivre noir pour ne pas masquer la finesse du saumon !"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Evita il pepe nero per non coprire il sapore delicato del salmone!"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Evite pimenta preta para não ocultar o sabor delicado do salmão!"
          }
        }
      }
    },
