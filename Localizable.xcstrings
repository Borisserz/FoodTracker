    "It's best to track your measurements on the same day each week, at the same time and under the same circumstances.": {
      "comment": "A description under the \"Weight-in\" toggle, explaining the importance of tracking weights at the same time each week.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Лучше делать замеры раз в неделю в один и тот же день и при одинаковых условиях."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Miss dein Gewicht am besten jede Woche am selben Tag, zur gleichen Zeit und unter gleichen Bedingungen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mídete el mismo día de la semana, a la misma hora y en las mismas condiciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mesurez-vous chaque semaine le même jour, à la même heure et dans les mêmes conditions."
