    },
    "Your average hydration (%@) is below the %@ target. Focus on drinking more fluids.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your average hydration (%@) is below the %@ target. Focus on drinking more fluids."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine durchschnittliche Flüssigkeitszufuhr (%1$@) liegt unter dem Ziel von %2$@. Trinke etwas mehr."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu hidratación media (%1$@) está por debajo del objetivo de %2$@. Bebe más líquidos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre hydratation moyenne (%1$@) est sous l'objectif de %2$@. Pensez à boire davantage."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua idratazione media (%1$@) è sotto l'obiettivo di %2$@. Bevi più liquidi."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A tua hidratação média (%1$@) está abaixo da meta de %2$@. Bebe mais líquidos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Средняя гидратация (%1$@) ниже цели %2$@. Старайтесь пить больше воды."
          }
        }
      }
    },
    "Your body is a reflection of your nutrition.\nTake control of your diet and achieve your dreams.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваше тело — отражение вашего питания.\nУправляйте рационом и достигайте целей."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Körper spiegelt deine Ernährung wider.\nÜbernimm die Kontrolle und erreiche deine Ziele."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu cuerpo refleja tu alimentación.\nToma el control y alcanza tus objetivos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre corps reflète votre alimentation.\nPrenez le contrôle et atteignez vos objectifs."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo corpo riflette la tua alimentazione.\nPrendi il controllo e raggiungi i tuoi obiettivi."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O seu corpo reflete a sua alimentação.\nAssuma o controlo e atinja os seus objetivos."
          }
        }
      }
    },
    "Your body uses 'Burned' energy to process 'Eaten' food.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Организм тратит сожжённую энергию на переработку съеденной пищи."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Körper nutzt verbrannte Energie zur Verarbeitung der Nahrung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu cuerpo usa energía quemada para procesar lo que comes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre corps utilise l'énergie brûlée pour traiter les aliments."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il corpo usa l'energia bruciata per elaborare il cibo assunto."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O corpo usa energia gasta para processar os alimentos."
          }
        }
      }
    },
    "Your daily average is %lld kcal, slightly above your goal. Consider adjusting portion sizes.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your daily average is %lld kcal, slightly above your goal. Consider adjusting portion sizes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Tagesdurchschnitt liegt bei %lld kcal, leicht über deinem Ziel. Passe ggf. die Portionsgrößen an."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu promedio diario es de %lld kcal, algo por encima de tu meta. Ajusta las porciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre moyenne est de %lld kcal, légèrement au-dessus de l'objectif. Ajustez les portions."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua media giornaliera è di %lld kcal, leggermente sopra l'obiettivo. Valuta porzioni più piccole."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A tua média diária é de %lld kcal, ligeiramente acima da meta. Considera ajustar as porções."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Среднее потребление — %lld ккал/день, чуть выше цели. Попробуйте немного скорректировать порции."
          }
        }
      }
    },
    "Your device storage database could not be opened, so changes may not persist after closing the app. Free up storage space and restart.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your device storage database could not be opened, so changes may not persist after closing the app. Free up storage space and restart."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Gerätespeicher-Datenbank konnte nicht geöffnet werden, sodass Änderungen nach dem Schließen eventuell nicht gespeichert bleiben. Gib Speicherplatz frei und starte neu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo abrir la base de datos del dispositivo, por lo que los cambios podrían no guardarse al cerrar la app. Libera espacio y reinicia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La base de données locale n'a pas pu être ouverte : les modifications risquent de ne pas être conservées. Libérez de l'espace et redémarrez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile aprire il database locale: le modifiche potrebbero non essere salvate alla chiusura. Libera spazio e riavvia."
          }
        },
        "pt-PT": {
