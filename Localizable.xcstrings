    "Temper the meat. Take the steak out of the fridge at least 30 minutes before cooking so it reaches room temperature. Pat completely dry with towels.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Адаптация мяса. Достань стейк из холодильника минимум за 30 минут до жарки, чтобы он стал комнатной температуры. Насухо промокни полотенцем."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fleisch temperieren. Steak mindestens 30 Min. vor dem Braten aus dem Kühlschrank nehmen und trockentupfen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Templa la carne. Saca el filete 30 min antes de cocinar y sécalo bien con papel."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tempérez la viande. Sortez le steak 30 min avant cuisson et épongez-le bien."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tempera la carne. Togli la bistecca dal frigo almeno 30 minuti prima e asciugala bene."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Tempere a carne. Retire o bife do frio 30 min antes e seque bem com papel."
          }
        }
      }
    },
