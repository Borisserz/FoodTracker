    "Pair iron-rich foods (spinach, lentils) with Vitamin C (citrus, peppers) to increase iron absorption by up to 300%.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pair iron-rich foods (spinach, lentils) with Vitamin C (citrus, peppers) to increase iron absorption by up to 300%."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kombiniere eisenreiche Lebensmittel (Spinat, Linsen) mit Vitamin C (Zitrus, Paprika), um die Eisenaufnahme um bis zu 300 % zu steigern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Combina alimentos ricos en hierro (espinacas, lentejas) con vitamina C (cítricos, pimientos) para aumentar su absorción hasta un 300%."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Associez des aliments riches en fer (épinards, lentilles) à la vitamine C (agrumes, poivrons) pour augmenter l'absorption jusqu'à 300 %."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Abbina cibi ricchi di ferro (spinaci, lenticchie) alla vitamina C (agrumi, peperoni) per aumentare l'assorbimento fino al 300%."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Combina alimentos ricos em ferro (espinafres, lentilhas) com vitamina C (citrinos, pimentos) para aumentar a absorção até 300%."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сочетайте продукты с железом (шпинат, чечевица) с витамином C (цитрусы, перец), чтобы повысить усвоение до 300%."
          }
        }
      }
    },
