        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur eine verkleinerte Kopie des Fotos, das Sie für die Mahlzeiten-, Menü-, Kochschritt- oder Fortschrittsanalyse aufnehmen oder auswählen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
