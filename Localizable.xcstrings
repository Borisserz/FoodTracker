    "Rinsing with boiling water removes saponins that cause bitterness.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Промывка кипятком удаляет сапонины — вещества, дающие горечь."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit kochendem Wasser abspülen entfernt bittere Saponine."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Enjuagar con agua hirviendo elimina las saponinas amargas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rincer à l'eau bouillante élimine l'amertume des saponines."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sciacquare con acqua bollente elimina l'amaro delle saponine."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Passar por água a ferver remove o amargor das saponinas."
          }
        }
      }
    },
    "Roasting. Preheat oven to 200°C. Place salmon skin-side down on parchment. Toss asparagus beside it with a squeeze of lemon. Bake for 12-15 minutes.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запекание. Разогрей духовку до 200°C. Выложи лосось на пергамент кожей вниз. Рядом выложи спаржу, слегка сбрызнув её лимоном. Запекай 12–15 минут."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Backen. Ofen auf 200 °C vorheizen. Lachs mit Haut nach unten auf Backpapier, Spargel mit Zitrone daneben legen und 12–15 Min. backen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hornear a 200 °C. Pon el salmón con piel hacia abajo y los espárragos con limón al lado. Hornea 12-15 minutos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuisson au four à 200 °C. Posez le saumon peau en bas avec les asperges citronnées à côté. Enfournez 12 à 15 min."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cottura in forno a 200 °C. Disponi il salmone con la pelle verso il basso e gli asparagi con limone accanto per 12-15 min."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Assar a 200 °C. Coloque o salmão com a pele para baixo e os espargos com limão ao lado durante 12-15 min."
          }
        }
      }
    },
