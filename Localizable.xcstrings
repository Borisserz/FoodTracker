          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les autorisations Apple Santé sont actuellement restreintes. Ouvrez Réglages iOS -> Santé -> Accès aux données et appareils pour autoriser la synchronisation."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I permessi di Apple Salute sono limitati. Apri Impostazioni iOS -> Salute -> Accesso dati e dispositivi per consentire la sincronizzazione."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
