    "Add FoodTracker widgets to your Home Screen to track calories, hydration, and shopping lists without opening the app.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add FoodTracker widgets to your Home Screen to track calories, hydration, and shopping lists without opening the app."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавьте виджеты FoodTracker на экран «Домой», чтобы следить за калориями, водой и списком покупок без открытия приложения."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge FoodTracker-Widgets zum Home-Bildschirm hinzu, um Kalorien, Wasser und Einkaufslisten direkt zu verfolgen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade los widgets de FoodTracker a tu pantalla de inicio para seguir calorías, agua y lista de compras sin abrir la app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez les widgets FoodTracker à votre écran d'accueil pour suivre calories, hydratation et courses sans ouvrir l'app."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi i widget di FoodTracker alla schermata Home per monitorare calorie, acqua e lista della spesa senza aprire l'app."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione os widgets do FoodTracker ao ecrã principal para acompanhar calorias, hidratação e compras sem abrir a app."
          }
        }
      }
    },
