rules_version = '2';

// =====================================================
// DO NOT DEPLOY FROM THIS REPOSITORY.
// `serzhanovich-ecosystem-ce700` uses merged rules across all apps.
// `firebase.json` intentionally omits the `firestore` section for safety.
// =====================================================
// Firestore security rules for WorkoutTracker & FoodTracker
// =====================================================
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Shared Firebase project: `serzhanovich-ecosystem-ce700`
    //
    // Collection: legendary_routines/{routineId} (WorkoutTracker)
    //   Read-only curated catalog (no PII). Written by Admin SDK only.
    //
    // Collection: explore_programs/{programId} (WorkoutTracker)
    //   Read-only curated catalog (no PII). Written by Admin SDK only.
    //
    // Collection: shared_workouts/{workoutId} (WorkoutTracker)
    //   Document ID: 1..128 chars
    //   Fields:
    //     - name: string (required, 1..200 chars)
    //     - title: string (required, must equal name)
    //     - icon: string (required, 1..100 chars)
    //     - exercises: list (required, 1..100 items; index 0 is map or non-empty string <= 200 chars)
    //     - creatorUid: string (required, must equal request.auth.uid on create)
    //     - status: string (required, must be "pending" on create; server-updated)
    //     - reportCount: int (required, must be 0 on create; server-updated)
    //     - moderationReason: string (required, must be "" on create; server-updated)
    //     - createdAt: timestamp (required, must equal request.time / serverTimestamp)
    //     - folderName: string | null (optional, <= 100 chars if string)
    //     - language: string (optional, <= 16 chars)
    //     - description: string (optional, <= 2000 chars)
    //
    // Collection: reports/{reportId} (WorkoutTracker)
    //   Document ID: "{workoutId}_{reporterUid}"
    //   Fields:
    //     - workoutId: string (required, 1..128 chars, no '/', must reference an approved shared_workout)
    //     - reporterUid: string (required, must equal request.auth.uid)
    //     - reason: string (required, enum: spam|hate|harassment|sexual|violence|dangerous|other)
    //     - status: string (required, must be "pending" on create)
    //     - createdAt: timestamp (required, must equal request.time / serverTimestamp)
    //     - details: string (optional, <= 500 chars)
    //
    // Collection: users/{userId}/blocked/{blockedUid} (WorkoutTracker)
    //   Document ID: blockedUid (1..128 non-whitespace chars, != userId)
    //   Fields:
    //     - blockedAt: timestamp (required, must equal request.time / serverTimestamp)
    //
    // Collections: premium_recipes, academy_categories, diets, fasting_plans (FoodTracker)
    //   Read-only curated catalogs (no PII). Loaded at cold start before Auth completes.
    //   Written by Admin SDK only.
    //
    // Server-only operational collections (config, food_ai_usage, food_search_usage, ai_usage, etc.):
    //   Denied to all clients by the root default-deny rule; accessed via Admin SDK only.
    //
    // ===============================================================
    // Helper Functions
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function hasRequiredFields(data, fields) {
      return data.keys().hasAll(fields);
    }

    function hasOnlyAllowedFields(data, fields) {
      return data.keys().hasOnly(fields);
    }

    function validStringLength(data, field, minLen, maxLen) {
      return data[field] is string
             && data[field].size() >= minLen
             && data[field].size() <= maxLen;
    }

    function isValidOptionalString(data, field, minLen, maxLen) {
      return !(field in data)
             || (data[field] is string
                 && data[field].size() >= minLen
                 && data[field].size() <= maxLen);
    }

    function isServerTimestamp(data, field) {
      return data[field] is timestamp
             && data[field] == request.time;
    }

    function isApprovedWorkout(workoutId) {
      let path = /databases/$(database)/documents/shared_workouts/$(workoutId);
      return exists(path) && get(path).data.status == "approved";
    }

    // ===============================================================
    // Domain Validators
    // ===============================================================

    function isValidSharedWorkoutCreate(data, workoutId) {
      return workoutId.size() > 0
             && workoutId.size() <= 128
             && hasOnlyAllowedFields(data, [
                  "name", "icon", "folderName", "exercises",
                  "title", "description", "creatorUid", "status",
                  "reportCount", "moderationReason", "createdAt", "language"
                ])
             && hasRequiredFields(data, [
                  "name", "icon", "exercises", "title",
                  "creatorUid", "status", "reportCount",
                  "moderationReason", "createdAt"
                ])
             && data.creatorUid is string
             && data.creatorUid == request.auth.uid
             && data.status is string
             && data.status == "pending"
             && data.reportCount is int
             && data.reportCount == 0
             && data.moderationReason is string
             && data.moderationReason == ""
             && validStringLength(data, "name", 1, 200)
             && data.title is string
             && data.title == data.name
             && validStringLength(data, "icon", 1, 100)
             && isServerTimestamp(data, "createdAt")
             && data.exercises is list
             && data.exercises.size() > 0
             && data.exercises.size() <= 100
             && ((data.exercises[0] is map && data.exercises[0].keys().size() <= 20)
                 || (data.exercises[0] is string
                     && data.exercises[0].size() > 0
                     && data.exercises[0].size() <= 200))
             && (!("folderName" in data)
                 || data.folderName == null
                 || (data.folderName is string
                     && data.folderName.size() <= 100))
             && isValidOptionalString(data, "language", 0, 16)
             && isValidOptionalString(data, "description", 0, 2000);
    }

    function isValidReportCreate(data, reportId) {
      return hasOnlyAllowedFields(data, [
               "workoutId", "reporterUid", "reason", "details", "status", "createdAt"
             ])
             && hasRequiredFields(data, [
                  "workoutId", "reporterUid", "reason", "status", "createdAt"
                ])
             && data.reporterUid is string
             && data.reporterUid == request.auth.uid
             && data.status is string
             && data.status == "pending"
             && validStringLength(data, "workoutId", 1, 128)
             && !data.workoutId.matches('.*(/|\\.\\.).*')
             && reportId == data.workoutId + "_" + request.auth.uid
             && isApprovedWorkout(data.workoutId)
             && data.reason is string
             && data.reason in ["spam", "hate", "harassment", "sexual", "violence", "dangerous", "other"]
             && isServerTimestamp(data, "createdAt")
             && isValidOptionalString(data, "details", 0, 500);
    }

    function isValidBlockedEntry(data, userId, blockedUid) {
      return blockedUid != userId
             && blockedUid.size() > 0
             && blockedUid.size() <= 128
             && blockedUid.matches('^\\S+$')
             && hasOnlyAllowedFields(data, ["blockedAt"])
             && hasRequiredFields(data, ["blockedAt"])
             && isServerTimestamp(data, "blockedAt");
    }

    // =====================================================
    // WORKOUT TRACKER RULES
    // =====================================================

    // === Curated content (public non-PII catalogs, read-only for clients) ===
    match /legendary_routines/{routineId} {
      allow read: if true;
      allow write: if false;
    }
    match /explore_programs/{programId} {
      allow read: if true;
      allow write: if false;
    }

    // === User-generated shared workouts ===
    match /shared_workouts/{workoutId} {
      // Read: require authentication; only approved workouts, OR your own doc (any status)
      allow read: if isAuthenticated()
                  && (resource.data.status == "approved"
                      || resource.data.creatorUid == request.auth.uid);

      // Create: authenticated user (anonymous auth permitted for zero-friction WT clients);
      // strict schema, server timestamp, pending status, zero reports, bounded exercises.
      allow create: if isAuthenticated()
                    && isValidSharedWorkoutCreate(request.resource.data, workoutId);

      // Update: server-only (moderation Cloud Functions use Admin SDK)
      allow update: if false;

      // Delete: only owner can delete their own document
      allow delete: if isAuthenticated()
                    && resource.data.creatorUid == request.auth.uid;
    }

    // === Reports ===
    match /reports/{reportId} {
      // Create: authenticated user; deterministic "{workoutId}_{uid}" ID;
      // target workout must exist AND be "approved" (prevents pending/hidden existence oracle);
      // server timestamp enforced.
      allow create: if isAuthenticated()
                    && isValidReportCreate(request.resource.data, reportId);

      allow read, update, delete: if false;
    }

    // === Per-user blocked list ===
    match /users/{userId}/blocked/{blockedUid} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId)
                            && isValidBlockedEntry(request.resource.data, userId, blockedUid);
      allow delete: if isOwner(userId);
    }

    // =====================================================
    // FOOD TRACKER RULES
    // =====================================================

    // === Curated content (read-only for clients, managed by Admin SDK) ===
    // Public read is intentional: these non-PII catalogs attach snapshot listeners at app init
    // (DietDataLoader, FastingDataLoader, AcademyDataLoader, RecipeDataLoader) before Firebase Auth
    // initializes; FoodTracker only performs anonymous sign-in lazily for AI/network calls.
    match /premium_recipes/{recipeId} {
      allow read: if true;
      allow write: if false;
    }
    match /academy_categories/{categoryId} {
      allow read: if true;
      allow write: if false;
    }
    match /diets/{dietId} {
      allow read: if true;
      allow write: if false;
    }
    match /fasting_plans/{planId} {
      allow read: if true;
      allow write: if false;
    }

    // === Default deny for everything else ===
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
