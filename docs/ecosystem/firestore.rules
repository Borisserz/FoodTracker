rules_version = '2';

// =====================================================
// MERGED ECOSYSTEM FIRESTORE SECURITY RULES
// Project: serzhanovich-ecosystem-ce700
// Apps: WorkoutTracker, FoodTracker, RPG Fitness (FitRPG),
//       Stepper, Yoga, Wardrobe, Autora (CoolAV.by)
// =====================================================
//
// ===============================================================
// Assumed Data Model (Summary)
// ===============================================================
//
// WorkoutTracker:
//   - legendary_routines/{routineId}, explore_programs/{programId}:
//       Public read-only curated catalogs (Admin SDK write only).
//   - shared_workouts/{workoutId}:
//       UGC workouts; create requires auth, strict schema, serverTimestamp
//       createdAt, status == "pending", reportCount == 0, moderationReason == "",
//       creatorUid == auth.uid, bounded exercises list (1..100). Update server-only.
//   - reports/{reportId}:
//       Shared by WorkoutTracker (id == "{workoutId}_{uid}", approved workout,
//       serverTimestamp createdAt, strict allowlist) and FitRPG (app == "fitrpg",
//       targetUid != auth.uid, serverTimestamp createdAt, strict allowlist).
//   - users/{userId}/blocked/{blockedUid}:
//       Shared by WorkoutTracker & FitRPG; owner-only, cannot block self,
//       strict allowlist ["blockedAt"] with serverTimestamp.
//
// FoodTracker:
//   - premium_recipes, academy_categories, diets, fasting_plans:
//       Public read-only curated catalogs loaded at cold start before Auth.
//   - custom_barcodes, global_community_foods:
//       Retired public read-only catalogs (writes denied to clients).
//
// RPG Fitness (FitRPG) & Stepper:
//   - users/{userId}:
//       Shared user doc. Owner read + registered non-anonymous read (FitRPG
//       friend discovery / duels). Economy/progression/gear/quest fields are
//       server-authoritative via Cloud Functions; client create/first-init only
//       permits exact starter defaults; updates cannot increase gold/energy or
//       touch protected keys. Delete is CF-only.
//   - users/{userId}/notifications/{notifId}:
//       Owner read/update(isRead)/delete; any signed-in user may create a
//       strictly validated unread notification (friend/duel/team invites).
//   - users/{userId}/{subcollection}/{document=**}:
//       Owner-only for other subcollections (e.g. Stepper workouts), excluding
//       `blocked` and `notifications` so their validators are never bypassed.
//   - clans/{clanId}:
//       Signed-in read; leader create with trophies == 1000 and treasuryGold == 0;
//       trophies/treasuryGold/activeWar/activeBuffs CF-only on update; non-member
//       self-join restricted strictly to adding own uid to memberIds/members
//       while preserving all existing memberIds.
//   - world_bosses/{bossId}, battles/{battleId}, matchmaking/{ticketId}:
//       FitRPG multiplayer collections.
//
// Yoga:
//   - yoga_users/{userId}, yoga_leaderboard/{entryId}: owner-scoped.
//
// Wardrobe:
//   - tryon_jobs/{jobId}: owner create (status == 'queued') & read; server update/delete.
//   - garments/{garmentId}: owner read/create/update/delete; split create vs update
//       so non-owners cannot hijack existing garments.
//   - tryon_cache/{cacheId}: server-only (Admin SDK).
//
// Autora / CoolAV.by:
//   - autora_listings/{id}: public read; split create vs update scoped to sellerId.
//   - autora_users/{uid}: auth read; owner create/update/delete.
//   - autora_favorites, autora_saved_searches, autora_blocks, autora_deferred,
//     autora_owned: owner-only with split create vs update preventing cross-user takeover.
//   - autora_chats/{id}, autora_messages/{id}: participant-scoped.
//   - autora_reports/{id}: create-only by signed-in reporter (reporterId == auth.uid, bounded).
//   - autora_fx/{id}: public read, server write.
//   - autora_bumps/{id}: server-only (unused by clients; listings store bumpedAt).
//   - autora_vin_reports/{vin}, autora_search_hits/{id}: read-only for clients.
//
// Root default deny: match /{document=**} { allow read, write: if false; }
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Shared Helper Functions
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isUser(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isNonAnonymousUser() {
      return isSignedIn()
        && 'firebase' in request.auth.token
        && request.auth.token.firebase is map
        && 'sign_in_provider' in request.auth.token.firebase
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    function hasRequiredFields(data, fields) {
      return data.keys().hasAll(fields);
    }

    function hasOnlyAllowedFields(data, fields) {
      return data.keys().hasOnly(fields);
    }

    function validStringLength(data, field, minLen, maxLen) {
      return data[field] is string
             && data[field].size() >= minLen
             && data[field].size() <= maxLen;
    }

    function isValidOptionalString(data, field, minLen, maxLen) {
      return !(field in data)
             || (data[field] is string
                 && data[field].size() >= minLen
                 && data[field].size() <= maxLen);
    }

    function isServerTimestamp(data, field) {
      return data[field] is timestamp
             && data[field] == request.time;
    }

    function isApprovedWorkout(workoutId) {
      let path = /databases/$(database)/documents/shared_workouts/$(workoutId);
      return exists(path) && get(path).data.status == "approved";
    }

    // ===============================================================
    // WorkoutTracker & Shared UGC Domain Validators
    // ===============================================================

    function isValidSharedWorkoutCreate(data, workoutId) {
      return workoutId.size() > 0
             && workoutId.size() <= 128
             && hasOnlyAllowedFields(data, [
                  "name", "icon", "folderName", "exercises",
                  "title", "description", "creatorUid", "status",
                  "reportCount", "moderationReason", "createdAt", "language"
                ])
             && hasRequiredFields(data, [
                  "name", "icon", "exercises", "title",
                  "creatorUid", "status", "reportCount",
                  "moderationReason", "createdAt"
                ])
             && data.creatorUid is string
             && data.creatorUid == request.auth.uid
             && data.status is string
             && data.status == "pending"
             && data.reportCount is int
             && data.reportCount == 0
             && data.moderationReason is string
             && data.moderationReason == ""
             && validStringLength(data, "name", 1, 200)
             && data.title is string
             && data.title == data.name
             && validStringLength(data, "icon", 1, 100)
             && isServerTimestamp(data, "createdAt")
             && data.exercises is list
             && data.exercises.size() > 0
             && data.exercises.size() <= 100
             && ((data.exercises[0] is map && data.exercises[0].keys().size() <= 20)
                 || (data.exercises[0] is string
                     && data.exercises[0].size() > 0
                     && data.exercises[0].size() <= 200))
             && (!("folderName" in data)
                 || data.folderName == null
                 || (data.folderName is string
                     && data.folderName.size() <= 100))
             && isValidOptionalString(data, "language", 0, 16)
             && isValidOptionalString(data, "description", 0, 2000);
    }

    function isValidWorkoutReportCreate(data, reportId) {
      return hasOnlyAllowedFields(data, [
               "workoutId", "reporterUid", "reason", "details", "status", "createdAt"
             ])
             && hasRequiredFields(data, [
                  "workoutId", "reporterUid", "reason", "status", "createdAt"
                ])
             && data.reporterUid is string
             && data.reporterUid == request.auth.uid
             && data.status is string
             && data.status == "pending"
             && validStringLength(data, "workoutId", 1, 128)
             && !data.workoutId.matches('.*(/|\\.\\.).*')
             && reportId == data.workoutId + "_" + request.auth.uid
             && isApprovedWorkout(data.workoutId)
             && data.reason is string
             && data.reason in ["spam", "hate", "harassment", "sexual", "violence", "dangerous", "other"]
             && isServerTimestamp(data, "createdAt")
             && isValidOptionalString(data, "details", 0, 500);
    }

    function isValidFitRPGReportCreate(data) {
      return hasOnlyAllowedFields(data, [
               "reporterUid", "targetUid", "reason", "createdAt", "app"
             ])
             && hasRequiredFields(data, [
                  "reporterUid", "targetUid", "reason", "createdAt", "app"
                ])
             && data.app == "fitrpg"
             && data.reporterUid is string
             && data.reporterUid == request.auth.uid
             && validStringLength(data, "targetUid", 1, 128)
             && data.targetUid != request.auth.uid
             && validStringLength(data, "reason", 1, 200)
             && isServerTimestamp(data, "createdAt");
    }

    function isValidBlockedEntry(data, userId, blockedUid) {
      return blockedUid != userId
             && blockedUid.size() > 0
             && blockedUid.size() <= 128
             && blockedUid.matches('^\\S+$')
             && hasOnlyAllowedFields(data, ["blockedAt"])
             && hasRequiredFields(data, ["blockedAt"])
             && isServerTimestamp(data, "blockedAt");
    }

    // =====================================================
    // WORKOUT TRACKER RULES
    // =====================================================

    // === Curated content (public non-PII catalogs, read-only for clients) ===
    match /legendary_routines/{routineId} {
      allow read: if true;
      allow write: if false;
    }
    match /explore_programs/{programId} {
      allow read: if true;
      allow write: if false;
    }

    // === User-generated shared workouts ===
    match /shared_workouts/{workoutId} {
      // Read: require authentication; only approved workouts, OR your own doc (any status)
      allow read: if isAuthenticated()
                  && (resource.data.status == "approved"
                      || resource.data.creatorUid == request.auth.uid);

      // Create: authenticated user (anonymous auth permitted for zero-friction WT clients);
      // strict schema, server timestamp, pending status, zero reports, bounded exercises.
      allow create: if isAuthenticated()
                    && isValidSharedWorkoutCreate(request.resource.data, workoutId);

      // Update: server-only (moderation Cloud Functions use Admin SDK)
      allow update: if false;

      // Delete: only owner can delete their own document
      allow delete: if isAuthenticated()
                    && resource.data.creatorUid == request.auth.uid;
    }

    // === Reports (WorkoutTracker + FitRPG) ===
    match /reports/{reportId} {
      allow create: if isAuthenticated()
                    && (
                      isValidWorkoutReportCreate(request.resource.data, reportId)
                      || isValidFitRPGReportCreate(request.resource.data)
                    );
      allow read, update, delete: if false;
    }

    // =====================================================
    // FOOD TRACKER RULES
    // =====================================================

    // === Curated content (read-only for clients, managed by admin) ===
    match /premium_recipes/{recipeId} {
      allow read: if true;
      allow write: if false;
    }
    match /academy_categories/{categoryId} {
      allow read: if true;
      allow write: if false;
    }
    match /diets/{dietId} {
      allow read: if true;
      allow write: if false;
    }
    match /fasting_plans/{planId} {
      allow read: if true;
      allow write: if false;
    }

    // Retired FoodTracker collections. Reads stay public so legacy clients do not break.
    // All client writes are denied: anonymous create used to spam barcodes, and any
    // signed-in user could overwrite global_community_foods.
    match /custom_barcodes/{barcode} {
      allow read: if true;
      allow write: if false;
    }

    match /global_community_foods/{foodId} {
      allow read: if true;
      allow write: if false;
    }

    // =====================================================
    // RPG FITNESS RULES & VALIDATORS
    // Economy / rewards / trophies / owned gear: Cloud Functions only.
    // Sibling apps may still merge non-FitRPG fields on users/{uid}.
    // =====================================================

    // FitRPG economy + social graph fields — never client-authoritative on update.
    // Gold may only decrease client-side (deposits); increases are CF-only.
    // Energy may only decrease client-side; increases via adjustEnergy CF.
    // Base stats / equipped slots / daily quest claims are CF-only.
    // clanId: leave or join only when auth.uid is already in that clan's memberIds.
    function fitrpgProtectedKeys() {
      return [
        'progressions', 'ownedEquipmentIds', 'classTrophies',
        'pvpWins', 'pvpTrophies', 'statPoints', 'basePower', 'maxEnergy',
        'friends', 'friendRequests',
        'baseStrength', 'baseDexterity', 'baseIntelligence', 'baseVitality',
        'equippedWeaponId', 'equippedArmorId', 'equippedRingId', 'equippedAmuletId',
        'lastEnergyRegenAt', 'pendingEnergyCharges',
        'lastTrainEnergyDay', 'trainEnergyAwardedToday',
        'claimedDailyQuests'
      ].toSet();
    }

    function fitrpgStarterClassProgOk(p) {
      return p is map
        && p.keys().hasOnly(['level', 'xp', 'totalReps', 'storyStage'])
        && p.level is int && p.level == 1
        && p.xp is int && p.xp == 0
        && p.totalReps is int && p.totalReps == 0
        && p.storyStage is int && p.storyStage == 1;
    }

    function fitrpgStarterProgressionsOk(data) {
      return !('progressions' in data)
        || (
          data.progressions is map
          && data.progressions.keys().hasOnly(['Archer', 'Mage', 'Swordsman', 'Healer'])
          && (!('Archer' in data.progressions) || fitrpgStarterClassProgOk(data.progressions.Archer))
          && (!('Mage' in data.progressions) || fitrpgStarterClassProgOk(data.progressions.Mage))
          && (!('Swordsman' in data.progressions) || fitrpgStarterClassProgOk(data.progressions.Swordsman))
          && (!('Healer' in data.progressions) || fitrpgStarterClassProgOk(data.progressions.Healer))
        );
    }

    // Validates starter caps & exact default values for all FitRPG economy/protected fields
    // on create (and first-time FitRPG character initialization on an existing sibling-app doc).
    // Sibling apps that omit FitRPG fields also pass because every check allows field absence.
    function fitrpgCreateFieldsOk(data) {
      return data.keys().size() <= 80
        && (!('gold' in data) || (data.gold is int && data.gold >= 0 && data.gold <= 100))
        && (!('energy' in data) || (data.energy is int && data.energy >= 0 && data.energy <= 100))
        && (!('maxEnergy' in data) || (data.maxEnergy is int && data.maxEnergy == 100))
        && (!('basePower' in data) || (data.basePower is int && data.basePower == 100))
        && (!('statPoints' in data) || (data.statPoints is int && data.statPoints == 0))
        && (!('baseStrength' in data) || (data.baseStrength is int && data.baseStrength == 10))
        && (!('baseDexterity' in data) || (data.baseDexterity is int && data.baseDexterity == 10))
        && (!('baseIntelligence' in data) || (data.baseIntelligence is int && data.baseIntelligence == 10))
        && (!('baseVitality' in data) || (data.baseVitality is int && data.baseVitality == 10))
        && (!('currentLevel' in data) || (data.currentLevel is int && data.currentLevel == 1))
        && (!('pvpWins' in data) || data.pvpWins == null || (data.pvpWins is int && data.pvpWins == 0))
        && (!('pvpTrophies' in data) || data.pvpTrophies == null || (data.pvpTrophies is int && data.pvpTrophies == 0))
        && (!('classTrophies' in data) || data.classTrophies == null || (data.classTrophies is map && data.classTrophies.keys().size() == 0))
        && (!('friends' in data) || data.friends == null || (data.friends is list && data.friends.size() == 0))
        && (!('friendRequests' in data) || data.friendRequests == null || (data.friendRequests is list && data.friendRequests.size() == 0))
        && (!('ownedEquipmentIds' in data)
            || (data.ownedEquipmentIds is list
                && data.ownedEquipmentIds.size() <= 8
                && data.ownedEquipmentIds.hasOnly([
                     'w_arch_1', 'a_arch_1', 'w_mage_1', 'a_mage_1',
                     'w_swor_1', 'a_swor_1', 'w_heal_1', 'a_heal_1'
                   ])))
        && (!('equippedWeaponId' in data)
            || data.equippedWeaponId == null
            || data.equippedWeaponId in ['w_arch_1', 'w_mage_1', 'w_swor_1', 'w_heal_1'])
        && (!('equippedArmorId' in data)
            || data.equippedArmorId == null
            || data.equippedArmorId in ['a_arch_1', 'a_mage_1', 'a_swor_1', 'a_heal_1'])
        && (!('equippedRingId' in data) || data.equippedRingId == null)
        && (!('equippedAmuletId' in data) || data.equippedAmuletId == null)
        && (!('clanId' in data) || data.clanId == null)
        && (!('lastEnergyRegenAt' in data) || data.lastEnergyRegenAt == null)
        && (!('pendingEnergyCharges' in data) || data.pendingEnergyCharges == null)
        && (!('lastTrainEnergyDay' in data) || data.lastTrainEnergyDay == null)
        && (!('trainEnergyAwardedToday' in data) || data.trainEnergyAwardedToday == null)
        && (!('claimedDailyQuests' in data) || data.claimedDailyQuests == null)
        && fitrpgStarterProgressionsOk(data);
    }

    // Energy never increases via client.
    // - If energy already exists on the doc, update MUST keep it and must not raise it
    //   (blocks delete-field-then-reintroduce-higher).
    // - If energy is absent on resource.data, client may NOT introduce energy > 100
    //   (blocks create-without-energy then update with energy: 999999).
    function fitrpgEnergyNotIncreased() {
      return (
        !('energy' in resource.data)
        && (
          !('energy' in request.resource.data)
          || (
            request.resource.data.energy is int
            && request.resource.data.energy >= 0
            && request.resource.data.energy <= 100
          )
        )
      ) || (
        'energy' in resource.data
        && 'energy' in request.resource.data
        && request.resource.data.energy is int
        && request.resource.data.energy >= 0
        && request.resource.data.energy <= resource.data.energy
      );
    }

    // Gold: same guard when gold already exists AND caps first introduction to <= 100
    // (blocks create-without-gold then update with gold: 999999).
    function fitrpgGoldNotIncreased() {
      return (
        !('gold' in resource.data)
        && (
          !('gold' in request.resource.data)
          || (
            request.resource.data.gold is int
            && request.resource.data.gold >= 0
            && request.resource.data.gold <= 100
          )
        )
      ) || (
        'gold' in resource.data
        && 'gold' in request.resource.data
        && request.resource.data.gold is int
        && request.resource.data.gold >= 0
        && request.resource.data.gold <= resource.data.gold
      );
    }

    // clanId: unchanged, cleared (leave), or set to a clan that already lists this uid.
    function fitrpgClanIdOk() {
      return !('clanId' in request.resource.data.diff(resource.data).affectedKeys())
        || !('clanId' in request.resource.data)
        || request.resource.data.clanId == null
        || (
          request.resource.data.clanId is string
          && exists(/databases/$(database)/documents/clans/$(request.resource.data.clanId))
          && get(/databases/$(database)/documents/clans/$(request.resource.data.clanId)).data.memberIds is list
          && request.auth.uid in get(/databases/$(database)/documents/clans/$(request.resource.data.clanId)).data.memberIds
        );
    }

    function fitrpgEconomyUnchanged() {
      return request.resource.data.keys().size() <= 80
        && request.resource.data.diff(resource.data)
             .affectedKeys()
             .hasAny(fitrpgProtectedKeys()) == false
        && request.resource.data.energy is int
        && request.resource.data.energy >= 0
        && request.resource.data.energy <= resource.data.energy
        && request.resource.data.gold is int
        && request.resource.data.gold >= 0
        && request.resource.data.gold <= resource.data.gold
        && fitrpgClanIdOk();
    }

    // First-time FitRPG character initialization on a users/{uid} doc previously created
    // by a sibling app (e.g. Wardrobe CF quota). Only allowed when no FitRPG fields exist yet.
    function fitrpgFirstTimeInitOk() {
      return !('gold' in resource.data)
        && !('energy' in resource.data)
        && !('progressions' in resource.data)
        && !('basePower' in resource.data)
        && !('ownedEquipmentIds' in resource.data)
        && !('pvpWins' in resource.data)
        && !('pvpTrophies' in resource.data)
        && fitrpgCreateFieldsOk(request.resource.data);
    }

    function isValidNotificationCreate(data, userId) {
      return data.keys().size() <= 15
        && hasOnlyAllowedFields(data, [
             'userId', 'title', 'message', 'type', 'isRead', 'createdAt', 'actionData'
           ])
        && hasRequiredFields(data, [
             'userId', 'title', 'message', 'type', 'isRead', 'createdAt'
           ])
        && data.userId is string
        && data.userId == userId
        && validStringLength(data, 'title', 1, 200)
        && validStringLength(data, 'message', 1, 1000)
        && data.type is string
        && data.type in ['DUEL', 'CLAN', 'SYSTEM', 'REWARD']
        && data.isRead is bool
        && data.isRead == false
        && data.createdAt is timestamp
        && (!('actionData' in data)
            || data.actionData == null
            || (data.actionData is map
                && data.actionData.keys().size() <= 10
                && (!('senderUid' in data.actionData)
                    || data.actionData.senderUid == request.auth.uid)));
    }

    function isValidNotificationUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead'])
        && request.resource.data.isRead is bool;
    }

    // Users Collection (and all its subcollections like notifications)
    match /users/{userId} {
      // Owner can always read their own doc, including anonymous sibling-app users.
      // Other anonymous users cannot enumerate profiles. Registered users can still
      // read profiles because FitRPG friend discovery and duels load users/{uid}.
      allow read: if isUser(userId) || isNonAnonymousUser();

      // Create character (or sibling-app first write). FitRPG starter caps & default
      // protected-field invariants apply unconditionally so omitting gold cannot bypass them.
      allow create: if isUser(userId)
                    && fitrpgCreateFieldsOk(request.resource.data);

      // Owner may update profile / stats — not economy increases (energy/gold CF-only up).
      allow update: if isUser(userId) && (
        // Non-FitRPG / partial merges (Wardrobe etc.): no protected keys touched,
        // and gold/energy cannot be raised or introduced above starter caps.
        (
          request.resource.data.keys().size() <= 80
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(fitrpgProtectedKeys())
          && fitrpgEnergyNotIncreased()
          && fitrpgGoldNotIncreased()
          && fitrpgClanIdOk()
        )
        // FitRPG character sync: energy bounded, gold not increased, protected keys unchanged
        || (
          ('energy' in resource.data)
          && ('gold' in resource.data)
          && fitrpgEconomyUnchanged()
        )
        // First-time FitRPG character creation on a doc created earlier by a sibling app
        || fitrpgFirstTimeInitOk()
      );

      // Account wipe of shared user doc is CF-only (cross-app safety).
      allow delete: if false;

      // Notifications subcollection: owner reads/updates(isRead)/deletes;
      // any authenticated user can CREATE a strictly validated unread notification
      // (friend requests, duel invites, team invites) — non-owners CANNOT overwrite existing docs.
      match /notifications/{notifId} {
        allow read, delete: if isUser(userId);
        allow update: if isUser(userId) && isValidNotificationUpdate();
        allow create: if isSignedIn() && isValidNotificationCreate(request.resource.data, userId);
      }

      // FitRPG & WorkoutTracker UGC block list — owner only; cannot block self; serverTimestamp required.
      match /blocked/{blockedUid} {
        allow read, delete: if isUser(userId);
        allow create, update: if isUser(userId)
                              && isValidBlockedEntry(request.resource.data, userId, blockedUid);
      }

      // All other subcollections: owner only (Stepper workouts, etc.).
      // Explicitly exclude `blocked` and `notifications` so wildcard cannot bypass their validators.
      match /{subcollection}/{document=**} {
        allow read, write: if isUser(userId)
                           && subcollection != 'blocked'
                           && subcollection != 'notifications';
      }
    }

    // Clans — create own clan; trophies/treasuryGold/activeWar/activeBuffs CF-only;
    // members only by leader/existing member, or self-join strictly adding own uid to memberIds/members.
    match /clans/{clanId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn()
                    && request.resource.data.leaderId == request.auth.uid
                    && !('activeWar' in request.resource.data)
                    && !('activeBuffs' in request.resource.data)
                    && request.resource.data.trophies is int
                    && request.resource.data.trophies == 1000
                    && (!('treasuryGold' in request.resource.data)
                        || (request.resource.data.treasuryGold is int
                            && request.resource.data.treasuryGold == 0))
                    && request.resource.data.memberIds is list
                    && request.resource.data.memberIds.size() >= 1
                    && request.resource.data.memberIds.size() <= 50
                    && request.auth.uid in request.resource.data.memberIds
                    && isValidOptionalString(request.resource.data, 'name', 1, 100)
                    && isValidOptionalString(request.resource.data, 'description', 0, 500)
                    && isValidOptionalString(request.resource.data, 'emblem', 1, 100);

      allow update: if isSignedIn()
                    && !('activeWar' in request.resource.data.diff(resource.data).affectedKeys())
                    && !('activeBuffs' in request.resource.data.diff(resource.data).affectedKeys())
                    && request.resource.data.trophies == resource.data.trophies
                    && (
                      // Existing leader or member updates (treasuryGold is CF-only via depositClanGold/activateClanBuff)
                      (
                        (
                          resource.data.leaderId == request.auth.uid
                          || (
                            resource.data.memberIds is list
                            && request.auth.uid in resource.data.memberIds
                          )
                        )
                        && request.resource.data.diff(resource.data)
                             .affectedKeys()
                             .hasOnly(['totalReps', 'members', 'description', 'emblem', 'name', 'memberIds', 'leaderId'])
                        && (
                          // leaderId may only change to a remaining member, and only by the current leader
                          // (covers leave-as-leader handoff and promote-to-leader).
                          !('leaderId' in request.resource.data.diff(resource.data).affectedKeys())
                          || (
                            resource.data.leaderId == request.auth.uid
                            && request.resource.data.leaderId is string
                            && request.resource.data.memberIds is list
                            && request.resource.data.leaderId in request.resource.data.memberIds
                          )
                        )
                      )
                      || (
                        // Self-join: non-member may ONLY modify ['memberIds', 'members'],
                        // MUST preserve every existing memberId, and add only own uid once.
                        request.resource.data.diff(resource.data)
                          .affectedKeys()
                          .hasOnly(['memberIds', 'members'])
                        && resource.data.memberIds is list
                        && request.resource.data.memberIds is list
                        && !(request.auth.uid in resource.data.memberIds)
                        && request.auth.uid in request.resource.data.memberIds
                        && request.resource.data.memberIds.size() == resource.data.memberIds.size() + 1
                        && request.resource.data.memberIds.size() <= 100
                        && request.resource.data.memberIds.hasAll(resource.data.memberIds)
                        && (!('members' in request.resource.data)
                            || (request.resource.data.members is list
                                && request.resource.data.members.size() <= 100
                                && (!('members' in resource.data)
                                    || !(resource.data.members is list)
                                    || request.resource.data.members.size() == resource.data.members.size() + 1)))
                      )
                    );

      allow delete: if isSignedIn()
                    && resource.data.leaderId == request.auth.uid;
    }

    // World Bosses — client read-only; Cloud Functions (Admin SDK) write
    match /world_bosses/{bossId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // Battles — only participants; combat HP/reps OK; winnerId/rewardsSettled/participantUids CF-or-immutable
    match /battles/{battleId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn()
                    && request.resource.data.participantUids is list
                    && request.auth.uid in request.resource.data.participantUids
                    && !('rewardsSettled' in request.resource.data)
                    && !('winnerId' in request.resource.data)
                    && !('surrenderedBy' in request.resource.data)
                    && !('createdByServer' in request.resource.data);

      allow update: if isSignedIn()
                    && resource.data.participantUids is list
                    && request.auth.uid in resource.data.participantUids
                    && request.resource.data.participantUids == resource.data.participantUids
                    && (
                      !('rewardsSettled' in resource.data)
                      || request.resource.data.rewardsSettled == resource.data.rewardsSettled
                    )
                    && (
                      !('rewardsSettled' in request.resource.data)
                      || (
                        'rewardsSettled' in resource.data
                        && request.resource.data.rewardsSettled == resource.data.rewardsSettled
                      )
                    )
                    // Client cannot forge winnerId (CF derives on settle)
                    && (
                      !('winnerId' in resource.data)
                      || request.resource.data.winnerId == resource.data.winnerId
                    )
                    && (
                      !('winnerId' in request.resource.data)
                      || ('winnerId' in resource.data
                          && request.resource.data.winnerId == resource.data.winnerId)
                    )
                    // createdByServer is CF-only (immutable once set; client cannot add)
                    && (
                      !('createdByServer' in request.resource.data.diff(resource.data).affectedKeys())
                    )
                    // Surrender: only set surrenderedBy to self
                    && (
                      !('surrenderedBy' in request.resource.data.diff(resource.data).affectedKeys())
                      || request.resource.data.surrenderedBy == request.auth.uid
                    );

      allow delete: if false;
    }

    // Matchmaking — own ticket create/update/delete; others read for invites
    match /matchmaking/{ticketId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn()
                    && request.resource.data.uid == request.auth.uid;

      allow update: if isSignedIn()
                    && (
                      resource.data.uid == request.auth.uid
                      || resource.data.targetUid == request.auth.uid
                      || (resource.data.pendingInvites is list
                          && request.auth.uid in resource.data.pendingInvites)
                    );

      allow delete: if isSignedIn()
                    && (resource.data.uid == request.auth.uid
                        || resource.data.targetUid == request.auth.uid);
    }

    // FitRPG UGC reports are merged into the shared /reports rule above (Workout + FitRPG).

    // =====================================================
    // YOGA (client collections; CF yogaDeleteUserData uses Admin SDK)
    // =====================================================
    match /yoga_users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /yoga_leaderboard/{entryId} {
      allow read: if request.auth != null;
      allow create, update, delete: if request.auth != null
                                    && request.auth.uid == entryId;
    }

    // =====================================================
    // WARDROBE (additive — do not alter Workout/Food/RPG/Yoga above)
    // Client: tryon_jobs + garments. Worker/cache: Admin SDK only.
    // users/{uid} quota merges already allowed via FitRPG sibling rules.
    // =====================================================
    function isValidGarment(data) {
      return data.keys().size() <= 20
        && data.userId is string
        && data.userId == request.auth.uid
        && data.imageUrl is string
        && data.imageUrl.size() > 0
        && data.imageUrl.size() <= 2048
        && isValidOptionalString(data, 'category', 0, 100)
        && isValidOptionalString(data, 'color', 0, 100)
        && isValidOptionalString(data, 'season', 0, 100)
        && isValidOptionalString(data, 'style', 0, 100);
    }

    match /tryon_jobs/{jobId} {
      allow read: if isSignedIn()
                  && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn()
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.keys().hasAll(['userId', 'status', 'bodyPhotoUrl'])
                    && request.resource.data.status == 'queued';
      // Updates/deletes: Cloud Functions Admin SDK only
      allow update, delete: if false;
    }

    match /garments/{garmentId} {
      allow read: if isSignedIn()
                  && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn()
                    && isValidGarment(request.resource.data);
      allow update: if isSignedIn()
                    && resource.data.userId == request.auth.uid
                    && isValidGarment(request.resource.data);
      allow delete: if isSignedIn()
                    && resource.data.userId == request.auth.uid;
    }

    match /tryon_cache/{cacheId} {
      allow read, write: if false;
    }

    // =====================================================
    // AUTORA / CoolAV.by (additive — do not alter apps above)
    // =====================================================
    function isValidAutoraListing(data) {
      return data.keys().size() <= 50
        && data.sellerId is string
        && data.sellerId == request.auth.uid;
    }

    function isValidAutoraUser(data, uid) {
      return data.keys().size() <= 25
        && data.id is string
        && data.id == uid;
    }

    function isValidAutoraFavorite(data) {
      return data.keys().size() <= 10
        && data.userId is string
        && data.userId == request.auth.uid
        && isValidOptionalString(data, 'listingId', 1, 128);
    }

    function isValidAutoraBlock(data) {
      return data.keys().size() <= 10
        && data.userId is string
        && data.userId == request.auth.uid
        && isValidOptionalString(data, 'sellerId', 1, 128);
    }

    function isValidAutoraDeferred(data) {
      return data.keys().size() <= 15
        && data.userId is string
        && data.userId == request.auth.uid
        && isValidOptionalString(data, 'listingId', 1, 128)
        && isValidOptionalString(data, 'note', 0, 2000);
    }

    function isValidAutoraOwned(data) {
      return data.keys().size() <= 20
        && data.userId is string
        && data.userId == request.auth.uid
        && isValidOptionalString(data, 'image', 0, 2048);
    }

    function isValidAutoraSavedSearch(data) {
      return data.keys().size() <= 25
        && data.userId is string
        && data.userId == request.auth.uid;
    }

    function isValidAutoraReportCreate(data) {
      return hasOnlyAllowedFields(data, [
               'id', 'listingID', 'listingId', 'reporterId', 'reason', 'details', 'at', 'createdAt'
             ])
        && data.reporterId is string
        && data.reporterId == request.auth.uid
        && validStringLength(data, 'reason', 1, 500)
        && ('listingID' in data || 'listingId' in data)
        && isValidOptionalString(data, 'id', 1, 200)
        && isValidOptionalString(data, 'listingID', 1, 128)
        && isValidOptionalString(data, 'listingId', 1, 128)
        && isValidOptionalString(data, 'details', 0, 500)
        && (!('at' in data) || data.at is number)
        && (!('createdAt' in data) || data.createdAt is timestamp);
    }

    match /autora_listings/{id} {
      allow read: if true;
      allow create: if isSignedIn()
                    && isValidAutoraListing(request.resource.data);
      allow update: if isSignedIn()
                    && resource.data.sellerId == request.auth.uid
                    && isValidAutoraListing(request.resource.data);
      allow delete: if isSignedIn()
                    && resource.data.sellerId == request.auth.uid;
    }

    match /autora_users/{uid} {
      allow read: if isSignedIn();
      allow create: if isUser(uid)
                    && isValidAutoraUser(request.resource.data, uid);
      allow update: if isUser(uid)
                    && isValidAutoraUser(request.resource.data, uid);
      allow delete: if isUser(uid);
    }

    match /autora_favorites/{id} {
      allow read: if isSignedIn()
                  && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn()
                    && isValidAutoraFavorite(request.resource.data);
      allow update: if isSignedIn()
                    && resource.data.userId == request.auth.uid
                    && isValidAutoraFavorite(request.resource.data);
      allow delete: if isSignedIn()
                    && resource.data.userId == request.auth.uid;
    }

    match /autora_saved_searches/{id} {
      allow read: if isSignedIn()
                  && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn()
                    && isValidAutoraSavedSearch(request.resource.data);
      allow update: if isSignedIn()
                    && resource.data.userId == request.auth.uid
                    && isValidAutoraSavedSearch(request.resource.data);
      allow delete: if isSignedIn()
                    && resource.data.userId == request.auth.uid;
    }

    match /autora_chats/{id} {
      allow read, delete: if isSignedIn()
                          && request.auth.uid in resource.data.participantIds;
      allow create: if isSignedIn()
                    && request.resource.data.participantIds is list
                    && request.auth.uid in request.resource.data.participantIds;
      allow update: if isSignedIn()
                    && request.auth.uid in resource.data.participantIds
                    && request.resource.data.participantIds is list
                    && request.auth.uid in request.resource.data.participantIds;
    }

    match /autora_messages/{id} {
      allow read: if isSignedIn()
                  && request.auth.uid in resource.data.participantIds;
      allow create: if isSignedIn()
                    && request.resource.data.participantIds is list
                    && request.auth.uid in request.resource.data.participantIds;
      allow update: if isSignedIn()
                    && request.auth.uid in resource.data.participantIds
                    && request.resource.data.participantIds is list
                    && request.auth.uid in request.resource.data.participantIds;
      allow delete: if isSignedIn()
                    && request.auth.uid in resource.data.participantIds;
    }

    match /autora_reports/{id} {
      allow create: if isSignedIn()
                    && isValidAutoraReportCreate(request.resource.data);
      allow read, update, delete: if false;
    }

    match /autora_blocks/{id} {
      allow read: if isSignedIn()
                  && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn()
                    && isValidAutoraBlock(request.resource.data);
      allow update: if isSignedIn()
                    && resource.data.userId == request.auth.uid
                    && isValidAutoraBlock(request.resource.data);
      allow delete: if isSignedIn()
                    && resource.data.userId == request.auth.uid;
    }

    match /autora_fx/{id} {
      allow read: if true;
      allow write: if false;
    }

    // Server-only: Autora iOS and CoolAV.by store bump timestamps on autora_listings.bumpedAt;
    // no client reads or writes autora_bumps.
    match /autora_bumps/{id} {
      allow read, write: if false;
    }

    match /autora_deferred/{id} {
      allow read, delete: if isSignedIn()
                          && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn()
                    && isValidAutoraDeferred(request.resource.data);
      allow update: if isSignedIn()
                    && resource.data.userId == request.auth.uid
                    && isValidAutoraDeferred(request.resource.data);
    }

    match /autora_owned/{id} {
      allow read, delete: if isSignedIn()
                          && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn()
                    && isValidAutoraOwned(request.resource.data);
      allow update: if isSignedIn()
                    && resource.data.userId == request.auth.uid
                    && isValidAutoraOwned(request.resource.data);
    }

    match /autora_vin_reports/{vin} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /autora_search_hits/{id} {
      allow read: if isSignedIn()
                  && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    // === Default deny for everything else ===
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
